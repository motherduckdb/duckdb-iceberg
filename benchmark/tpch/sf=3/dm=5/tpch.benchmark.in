# name: ${FILE_PATH}
# description: ${DESCRIPTION}
# group: [sf3]

argument sf 3

argument dm 5

argument data_dir data/persistent/benchmark/tpch/sf=5/

name Iceberg Q${QUERY_NUMBER_PADDED}
group tpch
subgroup sf${sf}

require avro

require parquet

require iceberg

require httpfs

require tpch

cache_file tpch_sf${sf}_dm${dm}

load
ATTACH ':memory:' AS mem;
USE mem;
CALL dbgen(sf=${sf});
CREATE SECRET (
    TYPE S3,
    KEY_ID 'admin',
    SECRET 'password',
    ENDPOINT '127.0.0.1:9000',
    URL_STYLE 'path',
    USE_SSL 0
);
ATTACH '' AS my_datalake (
    TYPE ICEBERG,
    CLIENT_ID 'admin',
    CLIENT_SECRET 'password',
    ENDPOINT 'http://127.0.0.1:8181'
);
create schema if not exists my_datalake.tpch_sf5_with_dm;
DROP TABLE IF EXISTS my_datalake."tpch_sf5_with_dm".customer;
DROP TABLE IF EXISTS my_datalake."tpch_sf5_with_dm".lineitem;
DROP TABLE IF EXISTS my_datalake."tpch_sf5_with_dm".nation;
DROP TABLE IF EXISTS my_datalake."tpch_sf5_with_dm".orders;
DROP TABLE IF EXISTS my_datalake."tpch_sf5_with_dm".part;
DROP TABLE IF EXISTS my_datalake."tpch_sf5_with_dm".partsupp;
DROP TABLE IF EXISTS my_datalake."tpch_sf5_with_dm".region;
DROP TABLE IF EXISTS my_datalake."tpch_sf5_with_dm".supplier;
DROP SCHEMA IF EXISTS my_datalake."tpch_sf5_with_dm";
CREATE SCHEMA IF NOT EXISTS my_datalake."tpch_sf5_with_dm";
CREATE TABLE my_datalake."tpch_sf5_with_dm".customer as select * from customer;
CREATE TABLE my_datalake."tpch_sf5_with_dm".lineitem as select * from lineitem;
CREATE TABLE my_datalake."tpch_sf5_with_dm".nation as select * from nation;
CREATE TABLE my_datalake."tpch_sf5_with_dm".orders as select * from orders;
CREATE TABLE my_datalake."tpch_sf5_with_dm".part as select * from part;
CREATE TABLE my_datalake."tpch_sf5_with_dm".partsupp as select * from partsupp;
CREATE TABLE my_datalake."tpch_sf5_with_dm".region as select * from region;
CREATE TABLE my_datalake."tpch_sf5_with_dm".supplier as select * from supplier;
INSERT INTO my_datalake.tpch_sf5_with_dm.orders SELECT * EXCLUDE sf FROM read_parquet('${data_dir}/orders_u1.parquet');
INSERT INTO my_datalake.tpch_sf5_with_dm.lineitem SELECT * EXCLUDE sf FROM read_parquet('${data_dir}/lineitem_u1.parquet');
DELETE FROM my_datalake.tpch_sf5_with_dm.orders   WHERE o_orderkey IN (SELECT o_orderkey FROM read_parquet('${data_dir}/delete_set_1.parquet'));
DELETE FROM my_datalake.tpch_sf5_with_dm.lineitem WHERE l_orderkey IN (SELECT o_orderkey FROM read_parquet('${data_dir}/delete_set_1.parquet'));
INSERT INTO my_datalake.tpch_sf5_with_dm.orders SELECT * EXCLUDE sf FROM read_parquet('${data_dir}/orders_u2.parquet');
INSERT INTO my_datalake.tpch_sf5_with_dm.lineitem SELECT * EXCLUDE sf FROM read_parquet('${data_dir}/lineitem_u2.parquet');
DELETE FROM my_datalake.tpch_sf5_with_dm.orders   WHERE o_orderkey IN (SELECT o_orderkey FROM read_parquet('${data_dir}/delete_set_2.parquet'));
DELETE FROM my_datalake.tpch_sf5_with_dm.lineitem WHERE l_orderkey IN (SELECT o_orderkey FROM read_parquet('${data_dir}/delete_set_2.parquet'));
INSERT INTO my_datalake.tpch_sf5_with_dm.orders SELECT * EXCLUDE sf FROM read_parquet('${data_dir}/orders_u3.parquet');
INSERT INTO my_datalake.tpch_sf5_with_dm.lineitem SELECT * EXCLUDE sf FROM read_parquet('${data_dir}/lineitem_u3.parquet');
DELETE FROM my_datalake.tpch_sf5_with_dm.orders   WHERE o_orderkey IN (SELECT o_orderkey FROM read_parquet('${data_dir}/delete_set_3.parquet'));
DELETE FROM my_datalake.tpch_sf5_with_dm.lineitem WHERE l_orderkey IN (SELECT o_orderkey FROM read_parquet('${data_dir}/delete_set_3.parquet'));
INSERT INTO my_datalake.tpch_sf5_with_dm.orders SELECT * EXCLUDE sf FROM read_parquet('${data_dir}/orders_u4.parquet');
INSERT INTO my_datalake.tpch_sf5_with_dm.lineitem SELECT * EXCLUDE sf FROM read_parquet('${data_dir}/lineitem_u4.parquet');
DELETE FROM my_datalake.tpch_sf5_with_dm.orders   WHERE o_orderkey IN (SELECT o_orderkey FROM read_parquet('${data_dir}/delete_set_4.parquet'));
DELETE FROM my_datalake.tpch_sf5_with_dm.lineitem WHERE l_orderkey IN (SELECT o_orderkey FROM read_parquet('${data_dir}/delete_set_4.parquet'));
INSERT INTO my_datalake.tpch_sf5_with_dm.orders SELECT * EXCLUDE sf FROM read_parquet('${data_dir}/orders_u5.parquet');
INSERT INTO my_datalake.tpch_sf5_with_dm.lineitem SELECT * EXCLUDE sf FROM read_parquet('${data_dir}/lineitem_u5.parquet');
DELETE FROM my_datalake.tpch_sf5_with_dm.orders   WHERE o_orderkey IN (SELECT o_orderkey FROM read_parquet('${data_dir}/delete_set_5.parquet'));
DELETE FROM my_datalake.tpch_sf5_with_dm.lineitem WHERE l_orderkey IN (SELECT o_orderkey FROM read_parquet('${data_dir}/delete_set_5.parquet'));

reload
CREATE SECRET (
    TYPE S3,
    KEY_ID 'admin',
    SECRET 'password',
    ENDPOINT '127.0.0.1:9000',
    URL_STYLE 'path',
    USE_SSL 0
);
ATTACH '' AS my_datalake (
    TYPE ICEBERG,
    CLIENT_ID 'admin',
    CLIENT_SECRET 'password',
    ENDPOINT 'http://127.0.0.1:8181',
    DEFAULT_SCHEMA 'tpch_sf5_with_dm'
);


run
set enable_external_file_cache=false;
USE my_datalake.tpch_sf5_with_dm;
set threads=3;
pragma tpch(${QUERY_NUMBER_PADDED});

