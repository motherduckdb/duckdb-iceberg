# name: test/mock_rest_catalog/smoke.test
# description: Mock end-to-end path, including fresh-connection visibility
# group: [mock_rest_catalog]

require-env CATALOG_TEST_CONFIG_SETUP mock

include test/sql/init_requires

statement ok
CREATE SCHEMA my_datalake.smoke;

statement ok
BEGIN;

statement ok
CREATE TABLE my_datalake.smoke.committed (id INTEGER);

statement ok
INSERT INTO my_datalake.smoke.committed VALUES (42), (84);

statement ok
COMMIT;

query I fresh
SELECT id FROM my_datalake.smoke.committed ORDER BY id;
----
42
84

statement ok
BEGIN;

statement ok
CREATE TABLE my_datalake.smoke.aborted AS SELECT 1 AS id;

statement ok
ROLLBACK;

query I fresh
SELECT count(*) FROM duckdb_tables() WHERE database_name = 'my_datalake' AND schema_name = 'smoke' AND table_name = 'aborted';
----
0

statement ok fresh
DROP TABLE my_datalake.smoke.committed;

statement ok fresh
DROP SCHEMA my_datalake.smoke;
