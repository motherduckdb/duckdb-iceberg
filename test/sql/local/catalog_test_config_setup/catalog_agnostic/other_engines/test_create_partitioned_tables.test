2	2021-06-20 14:45:00
3	2022-03-10 22:15:00
4	2020-01-15 10:00:00

# Nanosecond fractional digits roundtrip (manifest column bounds use 8-byte nanosecond encoding)
statement ok
drop table if exists my_datalake.default.test_timestamp_ns_fractional_format_version_3;

statement ok
CREATE TABLE my_datalake.default.test_timestamp_ns_fractional_format_version_3 (id INT, val TIMESTAMP_NS)
PARTITIONED BY (val)
WITH ('format-version' = 3);

statement ok
INSERT INTO my_datalake.default.test_timestamp_ns_fractional_format_version_3 VALUES
    (1, '2020-01-15 08:30:00.123456789'::TIMESTAMP_NS);

query II
SELECT id, val FROM my_datalake.default.test_timestamp_ns_fractional_format_version_3;
----
1	2020-01-15 08:30:00.123456789
