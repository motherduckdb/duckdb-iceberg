4	2020-01-15 10:00:00

query II nosort
SELECT id, val FROM my_datalake.default.test_table_partitioned_by_timestampns_month_format_version_3 ORDER BY id;
----
1	2020-01-15 08:30:00
2	2021-06-20 14:45:00
