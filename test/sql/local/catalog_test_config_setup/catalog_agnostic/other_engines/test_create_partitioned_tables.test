# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/other_engines/test_create_partitioned_tables.test
# description: create and populate partitioned tables by various types in v2 and v3, for cross-engine read testing
# group: [other_engines]

require-env CATALOG_TEST_CONFIG_SETUP

require avro

require parquet

require iceberg

require httpfs

require icu

statement ok
SET timezone='UTC';


statement ok
create schema if not exists my_datalake.default;

# ============================================================
# INT
# ============================================================


# ============================================================
# DATE — identity + year/month/day transforms
# ============================================================

statement ok
drop table if exists my_datalake.default.test_table_partitioned_by_date_format_version_2;

statement ok
CREATE TABLE my_datalake.default.test_table_partitioned_by_date_format_version_2 (id INT, val DATE)
PARTITIONED BY (val)
WITH ('format-version' = 2);

statement ok
INSERT INTO my_datalake.default.test_table_partitioned_by_date_format_version_2 VALUES
    (1, '2020-01-15'), (2, '2021-06-20'), (3, '2022-03-10'), (4, '2020-07-04');

statement ok
