# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/merge/merge_partition.test
# description: Test merge into with partitions
# group: [merge]

require-env CATALOG_TEST_CONFIG_SETUP

require avro

require parquet

require iceberg

require httpfs

# Do not ignore 'HTTP' error messages!
set ignore_error_messages

statement ok
set enable_logging=true

statement ok
set logging_level='debug'

statement ok
DROP TABLE IF EXISTS my_datalake.default.my_timeseries;

statement ok
DROP TABLE IF EXISTS my_datalake.default.my_timeseries_new;

statement ok
CREATE TABLE my_datalake.default.my_timeseries (ts TIMESTAMP, x DOUBLE PRECISION);

statement ok
ALTER TABLE my_datalake.default.my_timeseries SET PARTITIONED BY (year(ts));

statement ok
insert into my_datalake.default.my_timeseries VALUES ('2025-09-15',42)

statement ok
MERGE INTO my_datalake.default.my_timeseries
    USING (
        SELECT
            '2025-09-17'::TIMESTAMP as ts,
            42::DOUBLE PRECISION as x
    ) AS timeseries_updates
    ON my_datalake.default.my_timeseries.ts = timeseries_updates.ts
    WHEN NOT MATCHED THEN INSERT;

query II
SELECT * FROM my_datalake.default.my_timeseries order by all
----
2025-09-15 00:00:00	42.0
2025-09-17 00:00:00	42.0

statement ok
MERGE INTO my_datalake.default.my_timeseries
    USING (
        SELECT
            '2025-09-17'::TIMESTAMP as ts,
            43::DOUBLE PRECISION as x
    ) AS timeseries_updates
ON my_datalake.default.my_timeseries.ts = timeseries_updates.ts
WHEN MATCHED THEN UPDATE;

query II
SELECT * FROM my_datalake.default.my_timeseries order by all
----
2025-09-15 00:00:00	42.0
2025-09-17 00:00:00	43.0

# Distinct rows from the same data file must receive distinct MERGE row IDs.
statement ok
INSERT INTO my_datalake.default.my_timeseries VALUES ('2025-09-18', 44), ('2025-09-19', 45);

statement ok
MERGE INTO my_datalake.default.my_timeseries
    USING (
        VALUES
            ('2025-09-18'::TIMESTAMP, 46::DOUBLE PRECISION),
            ('2025-09-19'::TIMESTAMP, 47::DOUBLE PRECISION)
    ) AS timeseries_updates(ts, x)
ON my_datalake.default.my_timeseries.ts = timeseries_updates.ts
WHEN MATCHED THEN UPDATE;

query II
SELECT * FROM my_datalake.default.my_timeseries WHERE ts >= '2025-09-18' ORDER BY ALL
----
2025-09-18 00:00:00	46.0
2025-09-19 00:00:00	47.0

# Repeated source matches must still produce the standard MERGE cardinality error.
statement error
MERGE INTO my_datalake.default.my_timeseries
    USING (
        VALUES
            ('2025-09-18'::TIMESTAMP, 48::DOUBLE PRECISION),
            ('2025-09-18'::TIMESTAMP, 49::DOUBLE PRECISION)
    ) AS timeseries_updates(ts, x)
ON my_datalake.default.my_timeseries.ts = timeseries_updates.ts
WHEN MATCHED THEN UPDATE;
----
cannot affect the same target row more than once

statement ok
DROP TABLE my_datalake.default.my_timeseries;

statement ok
CREATE TABLE my_datalake.default.my_timeseries (ts TIMESTAMP, x DOUBLE PRECISION, y DOUBLE PRECISION);

statement ok
insert into my_datalake.default.my_timeseries VALUES ('2025-09-15', 43, 39)

statement ok
CREATE TABLE my_datalake.default.my_timeseries_new (ts TIMESTAMP, x DOUBLE PRECISION, y DOUBLE PRECISION);

statement ok
insert into my_datalake.default.my_timeseries_new VALUES ('2025-09-15', 43, 33)

statement ok
MERGE INTO my_datalake.default.my_timeseries old
    USING my_datalake.default.my_timeseries_new new
    USING(ts)
WHEN MATCHED AND (
    old.x  IS DISTINCT FROM new.y
) THEN UPDATE;

query III
FROM my_datalake.default.my_timeseries
----
2025-09-15 00:00:00	43.0	33.0
