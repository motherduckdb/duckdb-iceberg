# Small fixture: reset on every include; independent of Spark-generated tables.

statement ok
DROP TABLE IF EXISTS my_datalake.default.slt_bucket_partitioned_timestamp;

statement ok
CREATE TABLE my_datalake.default.slt_bucket_partitioned_timestamp (
    id INTEGER,
    ts_val TIMESTAMPTZ,
    label VARCHAR
)
PARTITIONED BY (bucket(4, ts_val)) WITH ('format-version' = '2');

