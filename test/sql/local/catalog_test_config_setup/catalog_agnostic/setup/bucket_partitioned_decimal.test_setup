# Small fixture: reset on every include; independent of Spark-generated tables.

statement ok
DROP TABLE IF EXISTS my_datalake.default.slt_bucket_partitioned_decimal;

statement ok
CREATE TABLE my_datalake.default.slt_bucket_partitioned_decimal (
    id INTEGER,
    amount DECIMAL(10, 2),
    label VARCHAR
)
PARTITIONED BY (bucket(4, amount)) WITH ('format-version' = '2');

