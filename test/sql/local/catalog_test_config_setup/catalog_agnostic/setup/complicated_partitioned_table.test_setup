# Preserve both partition specs and their data files.

statement ok
DROP TABLE IF EXISTS my_datalake.default.complicated_partitioned_table;

statement ok
CREATE TABLE my_datalake.default.complicated_partitioned_table (
	id int,
	ts TIMESTAMPTZ,
	customer varchar(20),
    amount long
)
PARTITIONED BY (year(ts))
WITH ('format-version' = '2', 'write.object-storage.enabled' = 'false');

