# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/test_tpch.test
# description: test integration with iceberg catalog read
# group: [catalog_agnostic]

require-env CATALOG_TEST_CONFIG_SETUP

include test/sql/init_requires

# Immutable SF1 fixture. A separate, versioned schema keeps this independent of
# Spark's tables. Bump the suffix when the fixture definition changes.
require tpch

statement ok
CREATE SCHEMA IF NOT EXISTS my_datalake.tpch_sf1_v1;

# foreach needs a nonempty list; continue skips the expensive block when all
# tables exist. Missing tables are created with CTAS so ordinary successful
# setup never leaves an empty table awaiting a separate INSERT.
statement ok
SET VARIABLE tpch_missing = (
    SELECT [count(*) > 0]
    FROM (VALUES ('customer'), ('lineitem'), ('nation'), ('orders'),
                 ('part'), ('partsupp'), ('region'), ('supplier')) AS expected(name)
    WHERE NOT EXISTS (
        SELECT 1 FROM information_schema.tables
        WHERE table_catalog = 'my_datalake' AND table_schema = 'tpch_sf1_v1'
          AND table_name = expected.name
    )
);

foreach missing <variable:tpch_missing>

onlyif missing=false
continue

statement ok
CREATE SCHEMA tpch_source;

statement ok
CALL dbgen(sf=1, schema='tpch_source');

foreach table customer lineitem nation orders part partsupp region supplier

statement ok
SET VARIABLE tpch_exists = (
    SELECT [count(*) > 0] FROM information_schema.tables
    WHERE table_catalog = 'my_datalake' AND table_schema = 'tpch_sf1_v1' AND table_name = '{table}'
);

foreach exists <variable:tpch_exists>

onlyif exists=true
continue

statement ok
CREATE TABLE my_datalake.tpch_sf1_v1.{table} AS SELECT * FROM tpch_source.{table};

endloop

endloop

statement ok
DROP SCHEMA tpch_source CASCADE;

endloop

statement ok
create view customer as select * from my_datalake.tpch_sf1_v1.customer;

statement ok
create view lineitem as select * from my_datalake.tpch_sf1_v1.lineitem;

statement ok
create view nation as select * from my_datalake.tpch_sf1_v1.nation;

statement ok
create view orders as select * from my_datalake.tpch_sf1_v1.orders;

statement ok
create view part as select * from my_datalake.tpch_sf1_v1.part;

statement ok
create view partsupp as select * from my_datalake.tpch_sf1_v1.partsupp;

statement ok
create view region as select * from my_datalake.tpch_sf1_v1.region;

statement ok
create view supplier as select * from my_datalake.tpch_sf1_v1.supplier;

loop i 1 9

query I
PRAGMA tpch({i})
----
<FILE>:{WORKING_DIRECTORY}/duckdb/extension/tpch/dbgen/answers/sf1/q0{i}.csv

endloop

loop i 10 23

query I
PRAGMA tpch({i})
----
<FILE>:{WORKING_DIRECTORY}/duckdb/extension/tpch/dbgen/answers/sf1/q{i}.csv

endloop
