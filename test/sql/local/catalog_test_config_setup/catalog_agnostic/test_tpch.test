# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/test_tpch.test
# description: test integration with iceberg catalog read
# group: [catalog_agnostic]

require-env CATALOG_TEST_CONFIG_SETUP

include test/sql/init_requires

include test/sql/local/catalog_test_config_setup/catalog_agnostic/setup/tpch_sf1.test_setup


statement ok
create view customer as select * from my_datalake.tpch_sf1_v1.customer;

statement ok
create view lineitem as select * from my_datalake.tpch_sf1_v1.lineitem;

statement ok
create view nation as select * from my_datalake.tpch_sf1_v1.nation;

statement ok
create view orders as select * from my_datalake.tpch_sf1_v1.orders;

statement ok
create view part as select * from my_datalake.tpch_sf1_v1.part;

statement ok
create view partsupp as select * from my_datalake.tpch_sf1_v1.partsupp;

statement ok
create view region as select * from my_datalake.tpch_sf1_v1.region;

statement ok
create view supplier as select * from my_datalake.tpch_sf1_v1.supplier;

loop i 1 9

query I
PRAGMA tpch({i})
----
<FILE>:{WORKING_DIRECTORY}/duckdb/extension/tpch/dbgen/answers/sf1/q0{i}.csv

endloop

loop i 10 23

query I
PRAGMA tpch({i})
----
<FILE>:{WORKING_DIRECTORY}/duckdb/extension/tpch/dbgen/answers/sf1/q{i}.csv

endloop
