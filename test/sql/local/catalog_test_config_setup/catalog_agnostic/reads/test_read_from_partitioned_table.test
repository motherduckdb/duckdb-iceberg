# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/reads/test_read_from_partitioned_table.test
# group: [reads]

require-env CATALOG_TEST_CONFIG_SETUP

include test/sql/init_requires

require icu

include test/sql/local/catalog_test_config_setup/catalog_agnostic/setup/day_partitioned_table.test_setup

include test/sql/local/catalog_test_config_setup/catalog_agnostic/setup/month_partitioned_table.test_setup

statement ok
SET default_transaction_invalidation_policy='SYNTACTIC_ERRORS_DO_NOT_INVALIDATE';


statement ok
set enable_logging=true

statement ok
set logging_level='debug'

statement ok
SET TimeZone = 'UTC';

query I
SELECT count(*) FROM my_datalake.default.slt_month_partitioned_table where ts < TIMESTAMPTZ '2025-02-01';
----
5

query I
SELECT count(*) FROM my_datalake.default.slt_month_partitioned_table where ts <= TIMESTAMPTZ '2025-02-01';
----
6

query I
SELECT count(*) FROM my_datalake.default.slt_month_partitioned_table where ts = TIMESTAMPTZ '2025-02-01';
----
1

query I
SELECT count(*) FROM my_datalake.default.slt_month_partitioned_table where ts > TIMESTAMPTZ '2025-02-01';
----
9

query I
SELECT count(*) FROM my_datalake.default.slt_month_partitioned_table where ts >= TIMESTAMPTZ '2025-02-01';
----
10


query I
SELECT count(*) FROM my_datalake.default.slt_day_partitioned_table where ts < TIMESTAMPTZ '2025-01-02';
----
4

query I
SELECT count(*) FROM my_datalake.default.slt_day_partitioned_table where ts <= TIMESTAMPTZ '2025-01-02';
----
9

query I
SELECT count(*) FROM my_datalake.default.slt_day_partitioned_table where ts = TIMESTAMPTZ '2025-01-02';
----
5

query I
SELECT count(*) FROM my_datalake.default.slt_day_partitioned_table where ts >= TIMESTAMPTZ '2025-01-02';
----
11

query I
SELECT count(*) FROM my_datalake.default.slt_day_partitioned_table where ts > TIMESTAMPTZ '2025-01-02';
----
6