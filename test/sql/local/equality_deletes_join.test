# name: test/sql/local/equality_deletes_join.test
# description: Equality deletes must be applied even when the iceberg scan is not the first child of a join
# group: [local]

require avro

require parquet

require iceberg

require httpfs

# Keep the iceberg scan on the right side of the join and disable all optimizers.
# Equality-delete columns are private scan inputs and must remain available.
statement ok
PRAGMA disable_optimizer;

# Only the `bir` column is selected, which is not an equality-delete column.
query I
SELECT t.bir
FROM (VALUES (1)) v(x), ICEBERG_SCAN('{WORKING_DIRECTORY}/data/persistent/equality_deletes/warehouse/mydb/mytable') t
ORDER BY ALL;
----
2025-01-04
2025-01-05

statement ok
PRAGMA enable_optimizer;
