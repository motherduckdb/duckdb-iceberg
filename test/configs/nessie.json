{
	"description": "Use Nessie as Iceberg Rest Catalog.",
	"on_init": "CREATE SECRET storage_secret ( TYPE S3, KEY_ID 'minioadmin', SECRET 'minioadmin', ENDPOINT '127.0.0.1:9002', URL_STYLE 'path', USE_SSL 0\n);\n\n\ncreate secret my_secret ( TYPE ICEBERG, CLIENT_ID 'client1', CLIENT_SECRET 's3cr3t', OAUTH2_SCOPE 'catalog sign', OAUTH2_SERVER_URI 'http://127.0.0.1:8080/realms/iceberg/protocol/openid-connect/token'\n);\n\n\nattach 'warehouse' as my_datalake ( type ICEBERG, URI 'http://127.0.0.1:19120/iceberg/', ACCESS_DELEGATION_MODE 'none', SECRET 'my_secret'\n);",
	"skip_error_messages": [],
	"statically_loaded_extensions": [
		"core_functions",
		"parquet",
		"avro",
		"iceberg",
		"httpfs"
	],
	"test_env": [
		{
			"env_name": "CATALOG_TEST_CONFIG_SETUP",
			"env_value": "nessie"
		},
		{
			"env_name": "FORMAT_V3_SUPPORT",
			"env_value": "false"
		},
		{
			"env_name": "UNKNOWN_SUPPORT",
			"env_value": "false"
		},
		{
			"env_name": "VARIANT_SUPPORT",
			"env_value": "false"
		},
		{
			"env_name": "GEOMETRY_SUPPORT",
			"env_value": "false"
		},
		{
			"env_name": "TIMESTAMP_NS_SUPPORT",
			"env_value": "false"
		},
		{
			"env_name": "COLUMN_DEFAULT_SUPPORT",
			"env_value": "false"
		},
		{
			"env_name": "TIMESTAMP_NS_DEFAULT_SUPPORT",
			"env_value": "false"
		},
		{
			"env_name": "TIMESTAMPTZ_NS_DEFAULT_SUPPORT",
			"env_value": "false"
		},
		{
			"env_name": "TIMETRAVEL_SUPPORT",
			"env_value": "false"
		},
		{
			"env_name": "SNAPSHOT_HISTORY_SUPPORT",
			"env_value": "false"
		},
		{
			"env_name": "METADATA_LOG_SUPPORT",
			"env_value": "false"
		},
		{
			"env_name": "METADATA_FILE_READ_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "STAGED_CREATE_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "MULTI_TABLE_COMMIT_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "FILE_CLEANUP_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "NAMESPACE_PROPERTIES_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "CASE_SENSITIVE_TABLE_NAMES_SUPPORT",
			"env_value": "true"
		},
		{
			"env_name": "SCAN_PLANNING_MODE",
			"env_value": "client"
		},
		{
			"env_name": "ATOMIC_COMMIT_CONFLICT_SUPPORT",
			"env_value": "unknown"
		}
	],
	"skip_tests": [
		{
			"reason": "Requires reparsing url paths in logs or paths in data files",
			"paths": [
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/iceberg_catalog_eager_refresh.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/reads/test_read_partitioned_table_type_promotion.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/irc_catalog_read_deletes.test"
			]
		},
		{
			"reason": "On ALTER TABLE, Nessie updates snapshot's schema_id as well alongside table_metadata.current_schema_id, so we don't log a warning.",
			"paths": [
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/alter/add_column/alter_add_column_warn_schema_mismatch.test",
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/alter/not_null/alter_drop_not_null_warn_schema_mismatch.test"
			]
		},
		{
			"reason": "Inserting into nessie triggers Relassert error that does not reproduce locally",
			"paths": [
				"test/sql/local/catalog_test_config_setup/catalog_agnostic/file_properties/test_parquet_options_physical_properties.test"
			]
		}
	]
}